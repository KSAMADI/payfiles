# Clé de signature des sessions (HMAC) — remplacez-la en production
DEV_SECRET=changez-moi-en-production

# Code OTP fixe en mode développement (désactiver en production : passer OTP_DEV_MODE=0)
OTP_DEV_CODE=123456
OTP_DEV_MODE=1

# URL de l'API FastAPI consommée par le proxy Next.js
API_URL=http://127.0.0.1:8100
